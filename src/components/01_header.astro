---
import heroImage from "../assets/img/tony-radford-the-coolest-englishman-on-the-planet.webp";
import heroBg from "../assets/img/hero-desktop.webp";
const imageUrl = heroImage.src;
const heroBgUrl = heroBg.src;
---

<section class="cv-section header-dark-theme" style={`border-bottom: none; padding-top: var(--space-lg); --hero-bg: url('${heroBgUrl}');`}>
  <div class="row align-items-center">
    <div class="col-md-8 pe-5">
      <h1 class="mb-3 text-white">Tony Radford</h1>
      <span class="hero-subtitle header-dark-subtitle">
        I help small businesses solve problems and achieve their goals by providing software and consultancy services. 
        <br />
        <br />I am currently focused on: 
        <br />
        <i class="bi bi-check2-square me-2"></i>        
        Delivering <a href="https://proactiveweb.design" target="_blank" class="header-dark-link">web design services</a>  for small businesses
        <br /><i class="bi bi-check2-square me-2"></i>
        My thought capture project <a href="https://zincontent.com" target="_blank" class="header-dark-link">Zin</a>.
      </span>
      <hr class="divider-accent" />
      <div class="d-flex flex-wrap gap-3 mt-3 mb-4">
        <a
          href="https://outlook.office365.com/owa/calendar/MyproactiveBusiness@proactiveapplications.com/bookings/"
          target="_blank"
          class="btn-accent"
        >
          <i class="fa fa-calendar me-1" aria-hidden="true"></i> Book a call
        </a>
        <a
          href="https://www.linkedin.com/in/tonyradford/"
          target="_blank"
          class="btn-ink header-dark-btn-ink"
        >
          <i class="fa-brands fa-linkedin me-1" aria-hidden="true"></i> Contact me on LinkedIn
        </a>
      </div>
    </div>
    <div
      class="col-md-4"
      style={`background-image: url('${imageUrl}'); background-size: cover; background-position: center; min-height: 300px; border-radius: var(--radius-lg);`}
      role="img"
      aria-label="Tony Radford"
    >
    </div>
  </div>
</section>

<style>
  /* TEMPORARY: dark header theme with hero background */
  .header-dark-theme {
    background-color: var(--ink);
    background-image: var(--hero-bg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    padding-left: calc(50vw - 50%);
    padding-right: calc(50vw - 50%);
  }
  .header-dark-subtitle {
    color: #ccc;
  }
  .header-dark-link {
    color: var(--red) !important;
  }
  .header-dark-btn-ink {
    background-color: #fff !important;
    color: var(--ink) !important;
  }
</style>
