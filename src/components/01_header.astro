---
import { Image } from "astro:assets";
import heroImage from "../assets/img/the-coolest-englishman-on-the-planet-tony-radford.webp";
---

<section class="py-4">
  <div class="row align-items-center border">
    <div class="col-md-3 text-center mb-md-0">
      <Image
        src={heroImage}
        alt="Tony Radford"
        class="img-fluid rounded"
      />
    </div>
    <div class="col-md-6">
      <h1>
        Tony Radford
        <small class="d-block text-muted">BUSINESS CONSULTANCY</small>
      </h1>
      
    </div>
    <div class="col-md-3">
    <div class="">
        <p>
          <i class="fa fa-calendar" aria-hidden="true" style="color: blue;"></i>
          <a
            href="https://outlook.office365.com/owa/calendar/MyproactiveBusiness@proactiveapplications.com/bookings/"
            target="_blank"
          >
            <b>Book a call</b>
          </a>
        </p>
        <p>
          <i class="fa-brands fa-linkedin" aria-hidden="true" style="color: blue;"></i>
          <a
            href="https://www.linkedin.com/in/tonyradford/"
            target="_blank"
          >
            <b>Contact me on LinkedIn</b>
          </a>
        </p>
      </div>
    </div>
  </div>
</section>