---
import { Image } from "astro:assets";
import heroImage from "../assets/img/tony-radford-the-coolest-englishman-on-the-planet.webp";
---

<section class="cv-section" style="border-bottom: none;">
  <div class="row align-items-center">
    <div class="col-md-2 text-center mb-3 mb-md-0">
      <Image
        src={heroImage}
        alt="Tony Radford"
        class="img-fluid rounded"
        style={`border-radius: var(--radius-lg)`}
      />
    </div>
    <div class="col-md-10">
      <h1>Tony Radford</h1>
      <span class="hero-subtitle">Business Consultancy</span>
      <hr class="divider-accent" />
      <div class="d-flex flex-wrap gap-3 mt-3">
        <a
          href="https://outlook.office365.com/owa/calendar/MyproactiveBusiness@proactiveapplications.com/bookings/"
          target="_blank"
          class="btn-accent"
        >
          <i class="fa fa-calendar me-1" aria-hidden="true"></i> Book a call
        </a>
        <a
          href="https://www.linkedin.com/in/tonyradford/"
          target="_blank"
          class="btn-ink"
        >
          <i class="fa-brands fa-linkedin me-1" aria-hidden="true"></i> Contact me on LinkedIn
        </a>
      </div>
    </div>
  </div>
</section>
